{
  "name": "finance-dashboard",
  "version": "1.0.0",
  "description": "Production-ready personal finance dashboard with Power BI integration",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate": "node --loader ts-node/esm src/data/db.ts",
    "db:seed": "node --loader ts-node/esm src/data/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "finance",
    "dashboard",
    "power-bi",
    "personal-finance",
    "transactions",
    "budget"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^9.2.2",
    "axios": "^1.6.5",
    "dotenv": "^16.3.1",
    "@azure/identity": "^3.4.0",
    "@azure/msal-node": "^1.18.0",
    "csv-parse": "^5.5.0",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.10.6",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0"
  }
}
